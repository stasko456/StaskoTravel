@model ActivityPaginationViewModel

<div class="container my-4">
    <h1 class="text-center mb-4">Activities</h1>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <form method="get" asp-controller="Activity" asp-action="Index">
                <div class="d-flex gap-2">
                    <input class="form-control form-control-lg"
                           type="search"
                           placeholder="Search activities..."
                           name="title"
                           value="@Context.Request.Query["title"]" />
                    <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        @foreach (var activity in Model.Activities)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title fw-bold text-primary mb-3">@activity.Title</h3>

                        <div class="mt-auto d-flex gap-2 pt-2">
                            <a asp-action="Edit" asp-route-id="@activity.Id" class="btn btn-warning fw-bold flex-grow-1">Edit</a>
                            <form asp-action="Delete" asp-route-id="@activity.Id" method="post" class="flex-grow-1">
                                <button type="submit" class="btn btn-danger fw-bold w-100" onclick="return confirm('Delete this activity?');">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Activity pagination">
            <ul class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item fw-bold">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(Model.CurrentPage - 1)"
                           asp-route-pageSize="3"
                           asp-route-title="@Context.Request.Query["title"]">Previous</a>
                    </li>
                }

                @if (Model.CurrentPage > 2)
                {
                    <li class="page-item">
                        <a class="page-link fw-bold" asp-action="Index"
                           asp-route-pageNumber="1"
                           asp-route-pageSize="3"
                           asp-route-title="@Context.Request.Query["title"]">1</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                }

                @for (int i = Model.CurrentPage - 1; i <= Model.CurrentPage + 1; i++)
                {
                    if (i > 0 && i <= Model.TotalPages)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link fw-bold" asp-action="Index"
                               asp-route-pageNumber="@i"
                               asp-route-pageSize="3"
                               asp-route-title="@Context.Request.Query["title"]">@i</a>
                        </li>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled">
                        <span class="page-link">...</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link fw-bold" asp-action="Index"
                           asp-route-pageNumber="@Model.TotalPages"
                           asp-route-pageSize="3"
                           asp-route-title="@Context.Request.Query["title"]">@Model.TotalPages</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link fw-bold" asp-action="Index"
                           asp-route-pageNumber="@(Model.CurrentPage + 1)"
                           asp-route-pageSize="3"
                           asp-route-title="@Context.Request.Query["title"]">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>