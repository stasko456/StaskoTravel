@model UserEditViewModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark text-center py-3">
                    <h2 class="h4 mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Edit Currency
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form method="post"
                          asp-controller="User"
                          asp-action="Edit"
                          id="changeHomeCurrencyForm"
                          class="position-relative">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3 position-relative">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Search Existing Currencies"
                                   name="title"
                                   id="currencies-search"
                                   autocomplete="off"
                                   autofocus />
                            <label for="currencies-search" class="text-muted">Search Existing Currencies</label>

                            <input id="select-currency" asp-for="HomeCurrecny" type="hidden" />
                            <span asp-validation-for="HomeCurrecny" class="text-danger small ms-1"></span>

                            <ul id="search-currencies-results"
                                class="list-group position-absolute w-100 shadow mt-1"
                                style="z-index: 1000; top: 100%; left: 0;"></ul>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2">
                            <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/features/currencies-conversion-api.js" asp-append-version="true"></script>
}