@using Microsoft.AspNetCore.Identity
@inject UserManager<User> userManager
@inject SignInManager<User> signInManager

<div class="navbar-collapse collapse justify-content-end">
    <ul class="navbar-nav">
        @if (signInManager.IsSignedIn(User))
        {
            <li class="nav-item">
                <div class="nav-link btn btn-link text-dark">
                    Hello @User?.Identity?.Name!
                </div>
            </li>
            <li class="nav-item">
                <form class="form-inline" asp-controller="User" asp-action="Logout">
                    <button type="submit" class="nav-link btn btn-link text-dark">
                        Logout
                    </button>
                </form>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link btn btn-link text-dark" asp-controller="User" asp-action="Register">
                    Register
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link btn btn-link text-dark" asp-controller="User" asp-action="Login">
                    Login
                </a>
            </li>
        }
    </ul>
</div>