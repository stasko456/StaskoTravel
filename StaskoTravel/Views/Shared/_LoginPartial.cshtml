@using Microsoft.AspNetCore.Identity
@inject UserManager<User> userManager
@inject SignInManager<User> signInManager

<ul class="navbar-nav align-items-center gap-2">
    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-white fw-semibold d-flex align-items-center pe-3">
                <i class="bi bi-person-circle fs-5 me-2"></i>
                Hello, @User?.Identity?.Name!
            </span>
        </li>
        <li class="nav-item">
            <form class="m-0" asp-controller="User" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-light fw-bold btn-sm px-3 py-2">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-outline-light fw-bold btn-sm px-3 py-2" asp-controller="User" asp-action="Register">
                <i class="bi bi-person-plus me-1"></i> Register
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-light text-primary fw-bold btn-sm px-3 py-2" asp-controller="User" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Login
            </a>
        </li>
    }
</ul>