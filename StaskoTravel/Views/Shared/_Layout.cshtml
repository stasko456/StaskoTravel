    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-compass fs-4"></i> StaskoTravel
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("User"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3 fw-semibold" href="#" id="activitiesDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-list-task me-1"></i> Manage Activities
                                    </a>
                                    <ul class="dropdown-menu shadow border-0" aria-labelledby="activitiesDropdown">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Activity" asp-action="Index">
                                                <i class="bi bi-grid me-2 text-primary"></i> All Activities
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Activity" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-success"></i> Create Activity
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle px-3 fw-semibold" href="#" id="tripsDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-airplane me-1"></i> Manage Trips
                                    </a>
                                    <ul class="dropdown-menu shadow border-0" aria-labelledby="tripsDropdown">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Trip" asp-action="Index">
                                                <i class="bi bi-journal-bookmark me-2 text-primary"></i> My Trips
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Trip" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2 text-success"></i> Create Trip
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - StaskoTravel - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
