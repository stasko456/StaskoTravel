@model TripActivityCreateViewModel

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h2 class="h4 mb-0 fw-bold">
                        <i class="bi bi-calendar-plus me-2"></i>Activity Specifications
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateTripActivity" method="post">
                        <input type="hidden" asp-for="TripId" />
                        <input type="hidden" asp-for="ActivityId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="ScheduledDate" type="date" class="form-control" placeholder="Scheduled Date" />
                            <label asp-for="ScheduledDate" class="text-muted">Scheduled Date</label>
                            <span asp-validation-for="ScheduledDate" class="text-danger small ms-1"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="EstimatedCost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <label asp-for="EstimatedCost" class="text-muted">Estimated Cost</label>
                            <span asp-validation-for="EstimatedCost" class="text-danger small ms-1"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2">
                            <a asp-action="Details" asp-controller="Trip" asp-route-id="@Model.TripId" class="btn btn-outline-secondary px-4 fw-bold">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">
                                Save Specifications
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}