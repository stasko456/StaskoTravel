@model TripDetailsViewModel

<div class="container my-5">
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-light text-primary fs-6 mb-2">@Model.TripCurrency</span>
                            <h1 class="h2 mb-0 fw-bold">@Model.DestinationCity</h1>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold text-dark">
                                <i class="bi bi-pencil-square me-1"></i>Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger fw-bold" onclick="return confirm('Delete this entire trip?');">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row text-center border-bottom pb-3 mb-4">
                        <div class="col-6 border-end">
                            <span class="text-muted small d-block">Start Date</span>
                            <strong class="fs-5">@Model.StartDate.ToLongDateString()</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">End Date</span>
                            <strong class="fs-5">@Model.EndDate.ToLongDateString()</strong>
                        </div>
                    </div>

                    <h3 class="h5 fw-bold mb-3">Trip Itinerary & Activities</h3>

                    @if (!Model.Activities.Any())
                    {
                        <div class="alert alert-light text-center border py-4 my-3">
                            <i class="bi bi-compass fs-1 text-muted d-block mb-2"></i>
                            <p class="mb-0 text-muted">No activities added yet. Use the search panel to add your first activity!</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border rounded">
                            @foreach (var activity in Model.Activities)
                            {
                                <div class="list-group-item p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <h5 class="mb-1 fw-bold text-primary">@activity.Title</h5>
                                        <div class="text-muted small">
                                            <span class="me-3"><i class="bi bi-calendar3 me-1"></i>@activity.ScheduledDate.ToLongDateString()</span>
                                            <span><i class="bi bi-tag me-1"></i>@activity.EstimatedCost @Model.TripCurrency</span>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <a asp-action="CreateTripActivity"
                                           asp-route-tripId="@Model.Id"
                                           asp-route-activityId="@activity.ActivityId"
                                           class="btn btn-outline-warning btn-sm fw-bold">
                                            Add Details
                                        </a>
                                        <form asp-controller="Trip"
                                              asp-action="RemoveActivityFromTrip"
                                              asp-route-tripId="@Model.Id"
                                              asp-route-activityId="@activity.ActivityId"
                                              method="post"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm fw-bold" onclick="return confirm('Remove activity?');">
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 2rem;">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h2 class="h5 mb-0 fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Add Activity
                    </h2>
                </div>
                <div class="card-body p-4">
                    <form class="d-flex flex-column position-relative"
                          method="post"
                          asp-controller="Trip"
                          asp-action="AddActivityToTrip"
                          id="addActivityForm">

                        <input type="hidden" name="tripId" value="@Model.Id" />
                        <input type="hidden" name="activityId" id="selectedActivityId" value="" />

                        <div class="mb-3 position-relative">
                            <label for="activitySearch" class="form-label fw-bold text-muted small">Search Existing Activities</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Type activity name..."
                                   name="title"
                                   id="activitySearch"
                                   autocomplete="off" />

                            <ul id="searchResults"
                                class="list-group position-absolute w-100 shadow d-none"
                                style="z-index: 1000; top: 100%; left: 0;"></ul>
                        </div>

                        <button type="submit" class="btn btn-success fw-bold py-2">
                            Add to Itinerary
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>