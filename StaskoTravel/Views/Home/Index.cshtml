@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border text-center">
    <div class="container-fluid py-4">
        <i class="bi bi-compass display-1 text-primary mb-3 d-inline-block"></i>
        <h1 class="display-4 fw-bold text-dark">Welcome to StaskoTravel</h1>
        <p class="col-md-8 mx-auto fs-5 text-dark">
            Your all-in-one platform for seamlessly planning trips, discovering activities, and managing itineraries.
        </p>

        @if (User?.Identity?.IsAuthenticated ?? false)
        {
            <div class="d-flex gap-3 justify-content-center mt-4">
                <a asp-controller="Trip" asp-action="Index" class="btn btn-primary btn-lg px-4 fw-bold">
                    <i class="bi bi-journal-bookmark me-2"></i>View My Trips
                </a>
                <a asp-controller="Trip" asp-action="Create" class="btn btn-outline-primary btn-lg px-4 fw-bold">
                    <i class="bi bi-plus-circle me-2"></i>Create New Trip
                </a>
            </div>
        }
        else
        {
            <div class="d-flex gap-3 justify-content-center mt-4">
                <a asp-controller="User" asp-action="Register" class="btn btn-primary btn-lg px-4 fw-bold">
                    Get Started
                </a>
                <a asp-controller="User" asp-action="Login" class="btn btn-outline-primary btn-lg px-4 fw-bold">
                    Sign In
                </a>
            </div>
        }
    </div>
</div>

<div class="row g-4 text-center mt-2">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <i class="bi bi-calendar-check fs-1 text-primary mb-3"></i>
                <h3 class="h5 fw-bold">Trip Planning</h3>
                <p class="text-muted small mb-0">
                    Organize your upcoming travel destinations, start and end dates, and regional currencies in one place.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <i class="bi bi-list-stars fs-1 text-primary mb-3"></i>
                <h3 class="h5 fw-bold">Custom Activities</h3>
                <p class="text-muted small mb-0">
                    Search and attach activities to your itinerary, set custom schedules, and track estimated costs.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="card-body">
                <i class="bi bi-cloud-sun fs-1 text-primary mb-3"></i>
                <h3 class="h5 fw-bold">Smart Insights</h3>
                <p class="text-muted small mb-0">
                    Keep your travel plans structured and stay prepared for every destination on your journey.
                </p>
            </div>
        </div>
    </div>
</div>